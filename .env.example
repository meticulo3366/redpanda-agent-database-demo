# .env.example - documents every variable in .env (which is gitignored).
#
# Do NOT copy this file by hand: scripts/00-preflight.sh (make preflight) writes
# .env on first run from .cockroachlabs.env plus generated passwords and the
# fixed names in docs/DESIGN.md section 3/4. It never overwrites an existing .env.
# Placeholder values only; never put real credentials in this file.

# --- CockroachDB -------------------------------------------------------------
# Admin connection string: the postgresql:// line from .cockroachlabs.env with the
# database rewritten to agent_memory and sslmode rewritten to require (psql on this
# machine has no ~/.postgresql/root.crt, so verify-full fails for psql only).
CRDB_ADMIN_URL="postgresql://<admin-user>:<admin-password>@<cluster-host>.cockroachlabs.cloud:26257/agent_memory?sslmode=require"
# host:port of the cluster (used to build the agent DSN)
CRDB_HOST="<cluster-host>.cockroachlabs.cloud:26257"
# demo database; all objects live in agent_memory.public
CRDB_DATABASE="agent_memory"
# least-privilege role used by the MCP server and the Connect pipelines
CRDB_AGENT_USER="agent_rw"
# generated: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32 (no URL encoding needed)
CRDB_AGENT_PASSWORD="<generated-32-alphanumeric-chars>"

# --- Redpanda Cloud (BYOC cluster in the adp-production environment) ---------
# Kafka API seed broker (TLS + SASL/SCRAM)
REDPANDA_BROKERS="seed-<id>.<cluster-id>.byoc.prd.cloud.redpanda.com:9092"
# Data Plane API base URL (topics, users, ACLs, secrets, Connect pipelines)
REDPANDA_DATAPLANE_API="https://api-<id>.<cluster-id>.byoc.prd.cloud.redpanda.com"
# Schema Registry (not used by the demo pipelines, kept for completeness)
REDPANDA_SCHEMA_REGISTRY_URL="https://schema-registry-<id>.<cluster-id>.byoc.prd.cloud.redpanda.com:30081"
# SASL/SCRAM-SHA-256 user used by the changefeeds and the pipelines
KAFKA_USER="agent-memory-demo"
# generated like CRDB_AGENT_PASSWORD; embedded in the changefeed sink URI
KAFKA_PASSWORD="<generated-32-alphanumeric-chars>"
# CDC topics written by the CockroachDB changefeeds
TOPIC_MEMORY_CDC="agent.memory.cdc"
TOPIC_ACCOUNTS_CDC="agent.accounts.cdc"

# --- Redpanda Agentic Data Plane (ADP) ---------------------------------------
# rpk ai environment that must be selected and logged in (rpk ai auth status)
ADP_ENV="adp-production"
# AI Gateway base URL (Connect-RPC: GuardrailService, A2A endpoints)
AIGW_URL="https://aigw.<cluster-id>.clusters.rdpa.co"

# Two LLM providers, one guardrail (both created by scripts/50-deploy-agent.sh).
#
# The managed agent runtime calls Bedrock with the Converse API, and this gateway
# build injects a Bedrock guardrail only on the invoke path. A guardrail attached
# to a Bedrock provider therefore never fires for the agent (it does fire for a
# direct POST .../model/<id>/invoke, which is how to show it on that path).
# For non-Bedrock providers the gateway evaluates the guardrail itself
# (ApplyGuardrail against the guardrail's Bedrock backend) before forwarding the
# request and after the response, so the denied topic, word filter and PII
# tests all block through the agent. The agent runs on the Anthropic provider
# by default for that reason.

# Provider the agent uses. Anthropic type; the API key comes from the org-shared
# secret ANTHROPIC_API_KEY (scope SCOPE_AI_GATEWAY, also used by the org provider
# anthropic-api-key), so calls on this path bill the org Anthropic key.
LLM_PROVIDER="zeke-anthropic-agent-memory"
# Anthropic model id (claude-sonnet-4-6 or claude-haiku-4-5)
LLM_MODEL="claude-sonnet-4-6"
# Optional: secret store reference for the Anthropic API key, read only when
# scripts/50-deploy-agent.sh has to create LLM_PROVIDER (default ANTHROPIC_API_KEY).
# ANTHROPIC_API_KEY_REF="ANTHROPIC_API_KEY"

# Bedrock provider: the guardrail's backend (bedrock_config.backend.llm_provider_ref,
# region us-east-2) and the alternative provider for own-account billing (Zeke's AWS
# account). It is created and kept even while the agent does not use it. Both
# variables are optional in .env; scripts/lib.sh defaults them to these values.
# Switch the agent to it with
#   rpk ai agent update memory-concierge --llm-provider "$BEDROCK_PROVIDER" --model "$BEDROCK_MODEL"
# and the LLM guardrail will no longer fire through the agent (use the direct
# invoke curl to show it). Do not reuse the shared provider zeke-bedrock-latest.
BEDROCK_PROVIDER="zeke-bedrock-agent-memory"
# Bedrock inference profile id
BEDROCK_MODEL="us.anthropic.claude-sonnet-4-6"
# guardrail attached to both providers; its backend is BEDROCK_PROVIDER
GUARDRAIL_NAME="agent-memory-guardrail"
# managed SQL MCP server pointing at CockroachDB
MCP_SERVER_NAME="crdb-agent-memory"
# the agent (display name "Memory Concierge")
AGENT_NAME="memory-concierge"
# the caller whose memory the demo exercises (subject of all memory rows)
DEMO_USER_EMAIL="<you>@redpanda.com"

# --- Runtime toggles (set on the command line, not in .env) -------------------
#   VERBOSE=1        log every Data Plane / AI Gateway HTTP call and status
#   FORCE=1          skip the confirmation prompt in scripts/90-teardown.sh
#   DRY_RUN=1        scripts/20-redpanda-setup.sh, 50-deploy-agent.sh and 90-teardown.sh only read and print the plan
#   SKIP_A2A=1       scripts/60-verify.sh skips the checks that talk to the agent
#   VERIFY_GUARDRAIL=1    scripts/60-verify.sh also sends a denied-topic message and expects guardrail_intervened
#   VERIFY_KEEP_MEMORY=1  keep the memory written by the verify round-trip instead of expiring it
